# copia este archivo a .env y cambia los valores
# las variables reales del sistema le ganan a este archivo
PORT=4027
NODE_ENV=development
REGION=LAN
URL_BASE=http://localhost:4027
LOG_NIVEL=debug

DRAFT_TAMANO_EQUIPO=5
DRAFT_BANS=3
DRAFT_TIEMPO_TURNO=30s

FUNCION_RANKED=true
FUNCION_HEROES_NUEVOS=false

# secretos (obligatorios en production)
API_KEY_ESTADISTICAS=cambia-esta-llave-de-20-o-mas
JWT_SECRETO="cambia-este-secreto-de-32-caracteres-o-mas"
