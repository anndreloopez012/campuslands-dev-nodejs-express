# copia este archivo como .env y cambia los valores

# development o production
NODE_ENV=development
PORT=3019

# datos del estudio
ESTUDIO_NOMBRE=Tinta Negra Studio
MONEDA=GTQ
IVA_PORCENTAJE=12

# reglas de las citas
PERMITIR_CITAS=true
MAX_CITAS_POR_DIA=3

# clave para crear disenos (header x-api-key)
# en production es obligatoria y debe tener 16 caracteres o mas
ADMIN_API_KEY=cambia-esta-clave-larga
