{
  "openapi": "3.0.3",
  "info": {
    "title": "API de MOBA esports",
    "version": "1.0.0",
    "description": "Equipos, torneos e inscripciones de una liga de MOBA. Todas las respuestas JSON usan el formato { ok, data } en caso de exito y { ok: false, message, codigo, errores? } en caso de error. Un metodo que no esta documentado para una ruta responde 405 con el header Allow. Una ruta inexistente responde 404 con codigo RUTA_NO_ENCONTRADA. Los requests con body deben enviar Content-Type: application/json y pesar menos de 10 KB."
  },
  "servers": [
    {
      "url": "/intermedio/ejercicio-27",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Sistema",
      "description": "Estado y documentacion de la API."
    },
    {
      "name": "Equipos",
      "description": "Alta, consulta y baja de equipos."
    },
    {
      "name": "Torneos",
      "description": "Consulta de torneos."
    },
    {
      "name": "Inscripciones",
      "description": "Equipos inscritos en cada torneo."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "operationId": "principal",
        "summary": "Ruta principal del ejercicio",
        "description": "Confirma que la API esta arriba.",
        "responses": {
          "200": {
            "description": "La API responde.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "message",
                    "topic"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "topic": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "message": "Ejercicio ejecutado correctamente",
                  "topic": "documentacion de endpoints"
                }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "operationId": "verDocumentacion",
        "summary": "Documentacion en HTML",
        "description": "Pagina con todos los endpoints, generada a partir de la misma especificacion OpenAPI.",
        "responses": {
          "200": {
            "description": "Pagina HTML autocontenida.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/docs/openapi.json": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "operationId": "verOpenApi",
        "summary": "Especificacion OpenAPI",
        "description": "Documento OpenAPI 3.0 en JSON. Se puede importar en Postman, Insomnia o Swagger UI.",
        "responses": {
          "200": {
            "description": "Especificacion completa.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/equipos": {
      "get": {
        "tags": [
          "Equipos"
        ],
        "operationId": "listarEquipos",
        "summary": "Lista equipos",
        "description": "Devuelve los equipos con filtros, orden y paginacion. El total viene tambien en el header X-Total-Count.",
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Filtra por region.",
            "schema": {
              "type": "string",
              "enum": [
                "na",
                "eu",
                "latam",
                "asia"
              ]
            },
            "example": "eu"
          },
          {
            "name": "buscar",
            "in": "query",
            "required": false,
            "description": "Texto contenido en el nombre o en el tag.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "example": "wolves"
          },
          {
            "name": "orden",
            "in": "query",
            "required": false,
            "description": "Campo de orden.",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "nombre",
                "victorias"
              ],
              "default": "id"
            },
            "example": "victorias"
          },
          {
            "$ref": "#/components/parameters/Pagina"
          },
          {
            "$ref": "#/components/parameters/Limite"
          }
        ],
        "responses": {
          "200": {
            "description": "Pagina de equipos.",
            "headers": {
              "X-Total-Count": {
                "description": "Cantidad total de resultados antes de paginar.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaEquipos"
                },
                "example": {
                  "ok": true,
                  "data": [
                    {
                      "id": 1,
                      "nombre": "Nebula Five",
                      "tag": "NBF",
                      "region": "eu",
                      "victorias": 34,
                      "derrotas": 12,
                      "creadoEn": "2026-09-01T12:00:00.000Z"
                    }
                  ],
                  "paginacion": {
                    "pagina": 1,
                    "limite": 10,
                    "total": 7,
                    "totalPaginas": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "Algun parametro de consulta es invalido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "Parametros de consulta invalidos",
                  "codigo": "CONSULTA_INVALIDA",
                  "errores": [
                    {
                      "campo": "region",
                      "mensaje": "debe ser uno de: na, eu, latam, asia"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Equipos"
        ],
        "operationId": "crearEquipo",
        "summary": "Crea un equipo",
        "description": "Registra un equipo nuevo con 0 victorias y 0 derrotas.",
        "requestBody": {
          "required": true,
          "description": "Datos del equipo.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EquipoNuevo"
              },
              "example": {
                "nombre": "Aurora Nine",
                "tag": "AUR",
                "region": "latam"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo creado.",
            "headers": {
              "Location": {
                "description": "Url del equipo creado.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEquipo"
                },
                "example": {
                  "ok": true,
                  "data": {
                    "id": 8,
                    "nombre": "Aurora Nine",
                    "tag": "AUR",
                    "region": "latam",
                    "victorias": 0,
                    "derrotas": 0,
                    "creadoEn": "2026-09-01T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "El body es invalido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "Datos invalidos",
                  "codigo": "VALIDACION",
                  "errores": [
                    {
                      "campo": "tag",
                      "mensaje": "solo admite mayusculas y numeros"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "El nombre o el tag ya existen.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "Ya existe un equipo con el tag NBF",
                  "codigo": "TAG_DUPLICADO"
                }
              }
            }
          },
          "415": {
            "description": "El Content-Type no es application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "El Content-Type debe ser application/json",
                  "codigo": "TIPO_NO_SOPORTADO"
                }
              }
            }
          }
        }
      }
    },
    "/equipos/{id}": {
      "get": {
        "tags": [
          "Equipos"
        ],
        "operationId": "obtenerEquipo",
        "summary": "Detalle de un equipo",
