      "post": {
        "tags": [
          "Inscripciones"
        ],
        "operationId": "inscribirEquipo",
        "summary": "Inscribe un equipo",
        "description": "Solo funciona mientras el torneo esta en etapa de inscripcion, hay cupos y el equipo no esta inscrito.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del torneo.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Equipo que se inscribe.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InscripcionNueva"
              },
              "example": {
                "equipoId": 3
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inscripcion creada.",
            "headers": {
              "Location": {
                "description": "Url de las inscripciones del torneo.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
