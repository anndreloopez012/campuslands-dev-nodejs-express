                },
                "example": {
                  "ok": false,
                  "message": "El id debe ser un entero positivo",
                  "codigo": "ID_INVALIDO"
                }
              }
            }
          },
          "404": {
            "description": "No existe el equipo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "No existe el equipo 99",
                  "codigo": "EQUIPO_NO_ENCONTRADO"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Equipos"
        ],
        "operationId": "actualizarEquipo",
        "summary": "Actualiza nombre o region",
        "description": "Solo se pueden cambiar el nombre y la region. El tag es permanente. Debe enviarse al menos un campo.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del equipo.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Campos a cambiar.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EquipoCambios"
              },
              "example": {
                "nombre": "Crimson Wolves Prime"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Equipo actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEquipo"
                },
                "example": {
                  "ok": true,
                  "data": {
                    "id": 1,
                    "nombre": "Crimson Wolves Prime",
                    "tag": "NBF",
                    "region": "eu",
                    "victorias": 34,
                    "derrotas": 12,
                    "creadoEn": "2026-09-01T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "El id o el body son invalidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "Datos invalidos",
                  "codigo": "VALIDACION",
                  "errores": [
                    {
                      "campo": "tag",
                      "mensaje": "campo no permitido"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No existe el equipo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "No existe el equipo 99",
                  "codigo": "EQUIPO_NO_ENCONTRADO"
                }
              }
            }
          },
          "409": {
            "description": "Otro equipo ya usa ese nombre.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "Ya existe un equipo llamado Nebula Five",
                  "codigo": "NOMBRE_DUPLICADO"
                }
              }
            }
          },
          "415": {
            "description": "El Content-Type no es application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "El Content-Type debe ser application/json",
                  "codigo": "TIPO_NO_SOPORTADO"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Equipos"
        ],
        "operationId": "eliminarEquipo",
        "summary": "Elimina un equipo",
        "description": "No se puede eliminar un equipo que esta inscrito en algun torneo.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id del equipo.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 7
          }
        ],
        "responses": {
          "200": {
            "description": "Equipo eliminado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEquipo"
                },
                "example": {
                  "ok": true,
                  "data": {
                    "id": 1,
                    "nombre": "Nebula Five",
                    "tag": "NBF",
                    "region": "eu",
                    "victorias": 34,
                    "derrotas": 12,
                    "creadoEn": "2026-09-01T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "El id no es un entero positivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "El id debe ser un entero positivo",
                  "codigo": "ID_INVALIDO"
                }
              }
            }
          },
          "404": {
            "description": "No existe el equipo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "No existe el equipo 99",
                  "codigo": "EQUIPO_NO_ENCONTRADO"
                }
              }
            }
          },
          "409": {
            "description": "El equipo esta inscrito en un torneo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "El equipo esta inscrito en al menos un torneo",
                  "codigo": "EQUIPO_INSCRITO"
                }
              }
            }
          }
        }
      }
    },
    "/torneos": {
      "get": {
        "tags": [
          "Torneos"
        ],
        "operationId": "listarTorneos",
        "summary": "Lista torneos",
        "description": "Devuelve los torneos con la cantidad de equipos inscritos.",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "description": "Filtra por etapa.",
            "schema": {
              "type": "string",
              "enum": [
                "inscripcion",
                "en_curso",
                "finalizado"
              ]
            },
            "example": "inscripcion"
          },
          {
            "name": "formato",
            "in": "query",
            "required": false,
            "description": "Filtra por formato.",
            "schema": {
              "type": "string",
              "enum": [
                "eliminacion",
                "liga",
                "suizo"
              ]
            },
            "example": "liga"
          },
          {
            "name": "orden",
            "in": "query",
            "required": false,
            "description": "Campo de orden.",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "inicio",
                "premio"
              ],
              "default": "id"
            },
            "example": "premio"
          },
          {
            "$ref": "#/components/parameters/Pagina"
          },
          {
            "$ref": "#/components/parameters/Limite"
          }
        ],
        "responses": {
          "200": {
            "description": "Pagina de torneos.",
            "headers": {
              "X-Total-Count": {
                "description": "Cantidad total de resultados antes de paginar.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaTorneos"
                },
                "example": {
                  "ok": true,
                  "data": [
                    {
                      "id": 1,
                      "nombre": "Copa Apertura",
                      "formato": "liga",
                      "estado": "inscripcion",
                      "cupos": 4,
                      "inscritos": 2,
                      "premio": 5000,
                      "inicio": "2026-12-01"
                    }
                  ],
                  "paginacion": {
                    "pagina": 1,
                    "limite": 10,
                    "total": 4,
                    "totalPaginas": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "Algun parametro de consulta es invalido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "message": "Parametros de consulta invalidos",
                  "codigo": "CONSULTA_INVALIDA",
                  "errores": [
                    {
                      "campo": "estado",
                      "mensaje": "debe ser uno de: inscripcion, en_curso, finalizado"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
