                    "tag": "NBF",
                    "region": "eu",
                    "victorias": 34,
                    "derrotas": 12,
                    "creadoEn": "2026-09-01T12:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "El id no es un entero positivo.",
