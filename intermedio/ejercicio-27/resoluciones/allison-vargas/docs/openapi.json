                    "torneoId": 1,
                    "equipo": {
                      "id": 3,
                      "nombre": "Jade Dragons",
                      "tag": "JDR"
                    },
                    "inscritoEn": "2026-11-04T16:00:00.000Z"
                  }
                }
              }
            }
          },
