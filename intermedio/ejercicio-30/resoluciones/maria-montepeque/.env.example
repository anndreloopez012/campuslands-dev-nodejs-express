# copia este archivo como .env

# development, production o test
NODE_ENV=development
PORT=3030

# en production es obligatorio y debe tener 32 caracteres o mas
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-verdad
JWT_EXPIRES_IN=8h

# intentos de login fallidos permitidos por email antes de bloquear
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
